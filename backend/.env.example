PORT=3000

# Neon (PostgreSQL + PostGIS). Sin esta variable la API usa los datos de prueba en memoria.
# Neon → Connection Details → copia la cadena "postgresql://..." (incluye sslmode=require).
DATABASE_URL=

# Ingesta programada (node-cron). Pon false para desactivarla en desarrollo.
INGESTION_ENABLED=true

# NASA FIRMS (focos de calor). Clave gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sin esta variable no se ingieren focos y se mantienen los que haya guardados.
MAP_KEY=
